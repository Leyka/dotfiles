theme = 0x96f
background = 262b30
font-family = JetBrainsMono Nerd Font
font-size = 16
font-feature = calt
font-feature = liga
macos-titlebar-style = transparent
window-colorspace = display-p3

working-directory = home
shell-integration = detect
cursor-style = bar
cursor-style-blink = false
mouse-hide-while-typing = true
window-padding-balance = true
confirm-close-surface = false

keybind = cmd+r>r=reload_config
keybind = cmd+r>e=equalize_splits

keybind = cmd+bracket_left=goto_split:left
keybind = cmd+bracket_right=goto_split:right
keybind = shift+cmd+bracket_left=goto_split:up
keybind = shift+cmd+bracket_right=goto_split:down

clipboard-paste-protection = false
copy-on-select = clipboard
