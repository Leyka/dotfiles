#!/usr/bin/env bash
set -euo pipefail

# Create directory
mkdir -p ~/.nvm

# Link nvm default-packages
ln -sf "$PWD/nvm/default-packages" ~/.nvm/default-packages

# Source nvm script (installed via Homebrew)
NVM_SH="$(brew --prefix nvm)/nvm.sh"
NVM_COMPLETION="$(brew --prefix nvm)/etc/bash_completion.d/nvm"

if [ -s "$NVM_SH" ]; then
	. "$NVM_SH"
else
	echo "nvm.sh not found at $NVM_SH"
	exit 1
fi

[ -s "$NVM_COMPLETION" ] && . "$NVM_COMPLETION"

if ! type nvm >/dev/null 2>&1; then
	echo "nvm failed to load"
	exit 1
fi

# Install LTS with nvm
nvm install --lts
nvm use --lts

# Stable symlink so non-interactive tools (coc.nvim etc.) can find node
mkdir -p "$HOME/.local/bin"
ln -sf "$(which node)" "$HOME/.local/bin/node"
ln -sf "$(which npm)" "$HOME/.local/bin/npm"
ln -sf "$(which npx)" "$HOME/.local/bin/npx"
